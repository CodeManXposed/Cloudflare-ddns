# Cloudflare API Token，权限设为 Zone / DNS / Edit，并限制到目标域名。
CF_API_TOKEN="替换为你的_API_Token"

# Cloudflare 控制台域名概览页中的 Zone ID。
CF_ZONE_ID="替换为你的_Zone_ID"

# 完整记录名。根域名可填 example.com，子域名可填 vps.example.com。
CF_RECORD_NAME="vps.example.com"

# 可选值: 4、6、both。
IP_VERSION="4"

# 1 表示自动 TTL；其他值为 60 到 86400 秒。
CF_TTL="1"

# true 使用 Cloudflare 代理，false 仅做 DNS 解析。
CF_PROXIED="false"

# 记录不存在时是否自动创建。
CREATE_MISSING="true"
